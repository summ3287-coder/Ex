local MainTab = Window:CreateTab("หลัก", 4483362458)
local EspTab = Window:CreateTab("มองทะลุ (ESP)", 4483362458)
local TeleportTab = Window:CreateTab("วาร์ป", 4483362458)

local InfiniteShootEnabled = false
local JesusWalkEnabled = false
local WaterPart = nil
local RunService = game:GetService("RunService")
