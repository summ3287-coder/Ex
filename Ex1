-- ตัวแปรตั้งค่า ESP และสี
local EspEnabled = false
local EspBoxEnabled = false
local EspLineEnabled = false
local EspColor = Color3.fromRGB(255, 0, 0)
local EspDrawings = {}

-- ----------------------------------------
-- 1. ฟังก์ชันยิงรัว (Fast Fire)
-- ----------------------------------------
MainTab:CreateToggle({
   Name = "ยิงไม่จำกัด / ยิงรัว (Fast Fire)",
   CurrentValue = false,
   Flag = "InfShoot",
   Callback = function(Value)
       InfiniteShootEnabled = Value
       if Value then
           task.spawn(function()
               while InfiniteShootEnabled do
                   local char = LocalPlayer.Character
                   if char then
                       local tool = char:FindFirstChildOfClass("Tool")
                       if tool then
                           if not tool:FindFirstChild("CooldownBypassed") then
                               local tag = Instance.new("BoolValue")
                               tag.Name = "CooldownBypassed"
                               tag.Parent = tool
                               
                               for _, v in pairs(tool:GetDescendants()) do
                                   if (v:IsA("NumberValue") or v:IsA("IntValue")) and 
                                      (v.Name:lower():find("cooldown") or v.Name:lower():find("delay") or v.Name:lower():find("reload")) then
                                       v.Value = 0
                                   end
                               end
                           end
                           
                           pcall(function()
                               tool:Activate()
                           end)
                       end
                   end
                   task.wait(0.05)
               end
           end)
       end
   end,
})

-- ----------------------------------------
-- 2. ฟังก์ชันเดินบนน้ำ (Walk on Water)
-- ----------------------------------------
MainTab:CreateToggle({
   Name = "เดินบนน้ำ (Walk on Water)",
   CurrentValue = false,
   Flag = "JesusFly",
   Callback = function(Value)
       JesusWalkEnabled = Value
       
       if JesusWalkEnabled then
           if not WaterPart then
               WaterPart = Instance.new("Part")
               WaterPart.Name = "JesusPlatform"
               WaterPart.Size = Vector3.new(25, 1, 25) 
               WaterPart.Anchored = true
               WaterPart.CanCollide = true
               WaterPart.Transparency = 0.5
               WaterPart.Color = Color3.fromRGB(0, 220, 255)
               WaterPart.Material = Enum.Material.SmoothPlastic
               WaterPart.Parent = workspace
           end

           task.spawn(function()
               while JesusWalkEnabled do
                   local char = LocalPlayer.Character
                   if char and char:FindFirstChild("HumanoidRootPart") then
                       local rootPos = char.HumanoidRootPart.Position
                       WaterPart.Position = Vector3.new(rootPos.X, rootPos.Y - 3.5, rootPos.Z)
                   end
                   task.wait(0.05)
               end
           end)
       else
           if WaterPart then
               WaterPart:Destroy()
               WaterPart = nil
           end
       end
   end,
})

-- ----------------------------------------
-- 3. ระบบ ESP (มองทะลุ)
-- ----------------------------------------
EspTab:CreateToggle({
   Name = "เปิด/ปิด ESP ทั้งหมด",
   CurrentValue = false,
   Flag = "EspToggle",
   Callback = function(Value)
       EspEnabled = Value
       if not Value then
           for _, data in pairs(EspDrawings) do
               if data.Box then data.Box:Remove() end
               if data.Line then data.Line:Remove() end
           end
           EspDrawings = {}
       end
   end,
})

EspTab:CreateToggle({
   Name = "แสดงกรอบสี่เหลี่ยม (Box)",
   CurrentValue = false,
   Flag = "EspBox",
   Callback = function(Value)
       EspBoxEnabled = Value
   end,
})

EspTab:CreateToggle({
   Name = "แสดงเส้นโยง (Tracer Line)",
   CurrentValue = false,
   Flag = "EspLine",
   Callback = function(Value)
       EspLineEnabled = Value
   end,
})

EspTab:CreateColorPicker({
   Name = "สีของ ESP",
   Color = Color3.fromRGB(255, 0, 0),
   Flag = "EspColorPicker",
   Callback = function(Value)
       EspColor = Value
   end,
})

RunService.RenderStepped:Connect(function()
   if not EspEnabled then return end
   local camera = workspace.CurrentCamera
   
   for _, player in pairs(Players:GetPlayers()) do
       if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") then
           local hrp = player.Character.HumanoidRootPart
           local humanoid = player.Character.Humanoid
           
           if not EspDrawings[player] then
               EspDrawings[player] = {
                   Box = Drawing.new("Square"),
                   Line = Drawing.new("Line")
               }
               EspDrawings[player].Box.Visible = false
               EspDrawings[player].Box.Filled = false
               EspDrawings[player].Box.Thickness = 1.5
               
               EspDrawings[player].Line.Visible = false
               EspDrawings[player].Line.Thickness = 1.5
           end
           
           local box = EspDrawings[player].Box
           local line = EspDrawings[player].Line
           
           if humanoid.Health > 0 then
               local vector, onScreen = camera:WorldToViewportPoint(hrp.Position)
               
               if onScreen then
                   if EspBoxEnabled then
                       local sizeX, sizeY = 2500 / vector.Z, 3500 / vector.Z
                       box.Size = Vector2.new(sizeX, sizeY)
                       box.Position = Vector2.new(vector.X - sizeX / 2, vector.Y - sizeY / 2)
                       box.Color = EspColor
                       box.Visible = true
                   else
                       box.Visible = false
                   end
                   
                   if EspLineEnabled then
                       line.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                       line.To = Vector2.new(vector.X, vector.Y)
                       line.Color = EspColor
                       line.Visible = true
                   else
                       line.Visible = false
                   end
               else
                   box.Visible = false
                   line.Visible = false
               end
           else
               box.Visible = false
               line.Visible = false
           end
       elseif EspDrawings[player] then
           if EspDrawings[player].Box then EspDrawings[player].Box:Remove() end
           if EspDrawings[player].Line then EspDrawings[player].Line:Remove() end
           EspDrawings[player] = nil
       end
   end
end)

-- ----------------------------------------
-- 4. ระบบวาร์ปไปหาผู้เล่น
-- ----------------------------------------
local selectedPlayerName = ""
local playerList = {}
for _, p in pairs(Players:GetPlayers()) do
   if p ~= LocalPlayer then
       table.insert(playerList, p.Name)
   end
end

local PlayerDropdown = TeleportTab:CreateDropdown({
   Name = "เลือกชื่อผู้เล่น",
   Options = playerList,
   CurrentOption = "",
   Flag = "TpPlayer",
   Callback = function(Option)
       selectedPlayerName = Option
   end,
})

Players.PlayerAdded:Connect(function(p)
   if p ~= LocalPlayer then
       table.insert(playerList, p.Name)
       PlayerDropdown:Refresh(playerList)
   end
end)

Players.PlayerRemoving:Connect(function(p)
   for i, v in ipairs(playerList) do
       if v == p.Name then
           table.remove(playerList, i)
           break
       end
   end
   PlayerDropdown:Refresh(playerList)
end)

TeleportTab:CreateButton({
   Name = "วาร์ปไปหาทันที!",
   Callback = function()
       local targetPlayer = Players:FindFirstChild(selectedPlayerName)
       if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
           local targetHrp = targetPlayer.Character.HumanoidRootPart
           local myChar = LocalPlayer.Character
           if myChar and myChar:FindFirstChild("HumanoidRootPart") then
               myChar.HumanoidRootPart.CFrame = targetHrp.CFrame + Vector3.new(0, 3, 0)
               Rayfield:Notify({
                  Title = "วาร์ปสำเร็จ",
                  Content = "วาร์ปไปหา " .. targetPlayer.Name .. " เรียบร้อย!",
                  Duration = 3,
               })
           end
       else
           Rayfield:Notify({
              Title = "Error",
              Content = "กรุณาเลือกชื่อผู้เล่นที่ต้องการวาร์ปก่อน!",
              Duration = 3,
           })
       end
   end,
})

