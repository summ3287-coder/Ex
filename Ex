-- Fixed Center FOV Circle (วาดวงกลมล็อคกลางจอถาวร)
local FOVCircle = Drawing.new("Circle")
FOVCircle.Radius = 140
FOVCircle.Color = Color3.fromRGB(255, 255, 255)
FOVCircle.Thickness = 1.5
FOVCircle.Filled = false
FOVCircle.Transparency = 1
FOVCircle.Visible = false

-- Storage for Tracer Lines
local TracersFolder = {}

local function getCenterScreen()
    return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
end

-- Get Enemy in FOV from Center Screen
local function getClosestPlayerInFOV()
    local closestPlayer = nil
    local shortestDistance = FOVCircle.Radius
    local centerPos = getCenterScreen()

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            if not (player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team) then
                local head = player.Character.Head
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                
                if onScreen then
                    local targetPos = Vector2.new(pos.X, pos.Y)
                    local distance = (centerPos - targetPos).Magnitude
                    
                    if distance < shortestDistance then
                        shortestDistance = distance
                        closestPlayer = player
                    end
                end
            end
        end
    end
    return closestPlayer
end

-- Main Loop
RunService.RenderStepped:Connect(function()
    local centerPos = getCenterScreen()
    
    -- 1. FOV Circle Always Centered
    FOVCircle.Position = centerPos
    FOVCircle.Visible = isAimbot

    -- 2. Aimbot Logic (Lock Target in Center FOV)
    if isAimbot then
        local target = getClosestPlayerInFOV()
        if target and target.Character and target.Character:FindFirstChild("Head") then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Character.Head.Position)
        end
    end

    -- Clear Old Tracers
    for _, line in pairs(TracersFolder) do
        line:Remove()
    end
    TracersFolder = {}

    -- 3. ESP & Tracers Loop
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
            
            if hrp then
                -- Box ESP (Highlight Method for Mobile Compatibility)
                local highlight = char:FindFirstChild("Mobile_Highlight")
                if isBoxESP then
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "Mobile_Highlight"
                        highlight.FillTransparency = 0.5
                        highlight.OutlineTransparency = 0
                        highlight.FillColor = Color3.fromRGB(255, 0, 0)
                        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                        highlight.Parent = char
                    end
                else
                    if highlight then highlight:Destroy() end
                end

                -- White Tracers Line (Draw Screen Line)
                if isTracers then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        local line = Drawing.new("Line")
                        line.From = Vector2.new(centerPos.X, centerPos.Y + 30) -- ลากจากกลางจอ
                        line.To = Vector2.new(screenPos.X, screenPos.Y)
                        line.Color = Color3.fromRGB(255, 255, 255) -- สีขาว
                        line.Thickness = 1.5
                        line.Transparency = 1
                        line.Visible = true
                        table.insert(TracersFolder, line)
                    end
                end
            end
        end
    end
end)
